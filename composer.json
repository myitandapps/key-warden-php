{
    "name": "key-warden/sdk",
    "description": "Official PHP client for Key-Warden - validate software licences online (seat- and revocation-aware) or verify signed Ed25519 tokens offline against your embedded public key.",
    "type": "library",
    "license": "MIT",
    "keywords": ["key-warden", "keywarden", "licence", "license", "licensing", "activation", "ed25519", "offline-verification"],
    "homepage": "https://key-warden.com",
    "authors": [
        { "name": "Key-Warden" }
    ],
    "require": {
        "php": ">=7.2",
        "ext-sodium": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "KeyWarden\\": "src/" }
    },
    "scripts": {
        "test": "php tests/run-tests.php"
    }
}
